diff --git a/kernels/arch/amd/gfx942/multiply.h b/kernels/arch/amd/gfx942/multiply.h
new file mode 100644
index 0000000..6a0f820
--- /dev/null
+++ b/kernels/arch/amd/gfx942/multiply.h
@@ -0,0 +1,26 @@
+#pragma once
+#include <cstdint>
+
+// Host compilation and every other GPU architecture retain the portable path.
+// The CMake option is deliberately opt-in: remeasure after toolchain changes.
+#if defined(KEYHUNT_GFX942_MAD) && defined(__HIP_DEVICE_COMPILE__) && \
+    defined(__gfx942__) && defined(__clang__)
+#define KEYHUNT_USE_GFX942_MAD 1
+namespace keyhunt::gpu::gfx942 {
+// One schoolbook limb: a*b + existing_product + incoming_carry. All four
+// inputs are 32-bit words, so the maximum is (B-1)^2 + 2*(B-1) = B^2-1.
+// The ISA's 65th result bit is therefore always zero and may be discarded.
+__device__ inline __attribute__((always_inline)) uint64_t multiply_accumulate(uint32_t a, uint32_t b,
+                                                       uint32_t word, uint32_t carry) {
+    const uint64_t addend = uint64_t(word) + carry; // retain the 33rd bit
+    uint64_t result;
+    // A 64-bit "v" operand is a consecutive VGPR pair. This single instruction
+    // reads every input before writing its output, so overlap needs no early
+    // clobber. Its carry output overwrites VCC, declared explicitly below.
+    // No memory, EXEC mask, wave communication, or hidden carry state is used.
+    asm("v_mad_u64_u32 %0, vcc, %1, %2, %3"
+        : "=v"(result) : "v"(a), "v"(b), "v"(addend) : "vcc");
+    return result;
+}
+} // namespace keyhunt::gpu::gfx942
+#endif
