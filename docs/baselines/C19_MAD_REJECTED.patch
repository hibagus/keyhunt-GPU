@@ -142,7 +143,12 @@ KEYHUNT_HD inline void mul(Field& out, const Field& a, const Field& b) {
         uint64_t carry = 0;
         for (unsigned j = 0; j < 8; ++j) {
             // (B-1)^2 + (B-1) + (B-1) = B^2-1, with B=2^32.
+#if defined(KEYHUNT_USE_GFX942_MAD)
+            const uint64_t sum = gfx942::multiply_accumulate(a.limb[i], b.limb[j],
+                                                            product[i+j], uint32_t(carry));
+#else
             const uint64_t sum = uint64_t(a.limb[i]) * b.limb[j] + product[i+j] + carry;
+#endif
             product[i+j] = uint32_t(sum);
             carry = sum >> 32;
         }
