{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "cpu-release",
      "displayName": "CPU release",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "cpu-debug",
      "inherits": "cpu-release",
      "displayName": "CPU debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "KEYHUNT_ENABLE_LTO": "OFF"
      }
    },
    {
      "name": "cpu-sanitizers",
      "inherits": "cpu-debug",
      "displayName": "CPU address/undefined sanitizers (legacy defects expected)",
      "cacheVariables": {
        "KEYHUNT_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "hip-release",
      "inherits": "cpu-release",
      "displayName": "AMD HIP gfx942 release",
      "cacheVariables": {
        "KEYHUNT_ENABLE_HIP": "ON",
        "CMAKE_HIP_ARCHITECTURES": "gfx942"
      }
    },
    {
      "name": "coordinator-release",
      "inherits": "cpu-release",
      "displayName": "Coordinator Release",
      "cacheVariables": {
        "KEYHUNT_ENABLE_COORDINATOR": "ON"
      }
    },
    {
      "name": "coordinator-debug",
      "inherits": "cpu-debug",
      "displayName": "Coordinator Debug",
      "cacheVariables": {
        "KEYHUNT_ENABLE_COORDINATOR": "ON"
      }
    },
    {
      "name": "coordinator-sanitizers",
      "inherits": "cpu-sanitizers",
      "displayName": "Coordinator Sanitizers",
      "cacheVariables": {
        "KEYHUNT_ENABLE_COORDINATOR": "ON"
      }
    },
    {
      "name": "coordinator-server",
      "inherits": "cpu-release",
      "displayName": "CPU-only coordinator package",
      "cacheVariables": {
        "KEYHUNT_ENABLE_COORDINATOR": "ON",
        "KEYHUNT_ENABLE_HTTPS_WORKER": "OFF",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "cuda-h200",
      "inherits": "cpu-release",
      "displayName": "Native NVIDIA CUDA H200 (sm_90)",
      "cacheVariables": {
        "KEYHUNT_ENABLE_CUDA": "ON",
        "CMAKE_CUDA_ARCHITECTURES": "90"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "cpu-release",
      "configurePreset": "cpu-release"
    },
    {
      "name": "cpu-debug",
      "configurePreset": "cpu-debug"
    },
    {
      "name": "cpu-sanitizers",
      "configurePreset": "cpu-sanitizers"
    },
    {
      "name": "hip-release",
      "configurePreset": "hip-release"
    },
    {
      "name": "coordinator-release",
      "configurePreset": "coordinator-release"
    },
    {
      "name": "coordinator-debug",
      "configurePreset": "coordinator-debug"
    },
    {
      "name": "coordinator-sanitizers",
      "configurePreset": "coordinator-sanitizers"
    },
    {
      "name": "coordinator-server",
      "configurePreset": "coordinator-server",
      "targets": [
        "keyhunt-coordinator"
      ]
    },
    {
      "name": "cuda-h200",
      "configurePreset": "cuda-h200"
    }
  ],
  "testPresets": [
    {
      "name": "cpu-release",
      "configurePreset": "cpu-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "cpu-debug",
      "configurePreset": "cpu-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "cpu-sanitizers",
      "configurePreset": "cpu-sanitizers",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "hip-release",
      "configurePreset": "hip-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "coordinator-release",
      "configurePreset": "coordinator-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "coordinator-debug",
      "configurePreset": "coordinator-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "coordinator-sanitizers",
      "configurePreset": "coordinator-sanitizers",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "cuda-h200",
      "configurePreset": "cuda-h200",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
